# Live/current Robinhood RPC. Official public endpoint is the code default.
ROBINHOOD_RPC_URL=

# Historical archive RPC.
# Keyless tested fallback:
#   https://rpc.solidrpc.io/public/evm/4663
# For sustained backfills, SolidRPC Free can use:
#   ROBINHOOD_ARCHIVE_RPC_URL=https://rpc.solidrpc.io/evm/4663
#   ROBINHOOD_ARCHIVE_RPC_API_KEY=<free key>
# Keep the key in a local .env / GitHub secret; never commit it.
ROBINHOOD_ARCHIVE_RPC_URL=
ROBINHOOD_ARCHIVE_RPC_API_KEY=

# Optional hoodexplorer key. This provider is not required by HLP.
HOODEXPLORER_API_KEY=
